{
  "name": "mawaru",
  "productName": "Mawaru",
  "private": true,
  "version": "0.1.0",
  "description": "Editor de mockups 3D de dispositivos con animación por keyframes y exportación a vídeo",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite build && node tools/serve.mjs --open",
    "app": "bash tools/make-app.sh",
    "models": "python3 tools/rotato2glb.py",
    "presets": "python3 tools/extract-presets.py",
    "desktop": "vite build && electron .",
    "desktop:dev": "MAWARU_DEV_URL=http://127.0.0.1:5173 electron .",
    "dist:mac": "vite build && electron-builder --mac",
    "desktop:link-models": "mkdir -p \"$HOME/Library/Application Support/Mawaru\" && ln -sfn \"$PWD/local-models\" \"$HOME/Library/Application Support/Mawaru/local-models\""
  },
  "dependencies": {
    "fflate": "0.8.3",
    "mp4-muxer": "5.2.2",
    "three": "0.170.0"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "app.mawaru.desktop",
    "productName": "Mawaru",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Mawaru ${version}"
    }
  }
}
