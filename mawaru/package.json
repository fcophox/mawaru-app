{
  "name": "mawaru",
  "productName": "Mawaru",
  "private": true,
  "version": "0.1.0",
  "description": "Editor de mockups 3D de dispositivos con animación por keyframes y exportación a vídeo",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite build && node tools/serve.mjs --open",
    "app": "bash tools/make-app.sh",
    "models": "python3 tools/rotato2glb.py",
    "presets": "python3 tools/extract-presets.py",
    "desktop": "vite build && electron .",
    "desktop:dev": "MAWARU_DEV_URL=http://127.0.0.1:5173 electron .",
    "dist:mac": "vite build && electron-builder --mac --universal",
    "desktop:link-models": "mkdir -p \"$HOME/Library/Application Support/Mawaru\" && ln -sfn \"$PWD/local-models\" \"$HOME/Library/Application Support/Mawaru/local-models\"",
    "icon": "electron tools/render-icon.cjs",
    "dist:mac:arm64": "vite build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "mp4-muxer": "5.2.2",
    "three": "0.170.0"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "app.mawaru.desktop",
    "productName": "Mawaru",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg"
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "12.0",
      "darkModeSupport": true,
      "extendInfo": {
        "CFBundleDisplayName": "Mawaru",
        "NSHumanReadableCopyright": "© 2026 Mawaru"
      }
    },
    "dmg": {
      "title": "Mawaru ${version}",
      "artifactName": "Mawaru-${version}-${arch}.${ext}",
      "iconSize": 112,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "copyright": "© 2026 Mawaru"
  },
  "author": "Mawaru"
}
